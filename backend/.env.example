# Copy to backend/.env and fill in. Never commit backend/.env.
# Provisioning and how to read these values: docs/azure-setup.md

AZURE_OPENAI_ENDPOINT=https://manual-assist-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Confirmed against a live call when the provider is written.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Speech-to-text, from the azure-stt-support resource. Voice input only; read-aloud
# answers are a non-goal. Region is the resource's location, e.g. southeastasia.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEECH_LANGUAGE=en-US

TAVILY_API_KEY=

# Optional. Comma-separated hosts to restrict web search to; empty searches the open web.
# Passed to Tavily as include_domains. Never write site: operators here — Tavily treats them
# as ordinary query words, which is what made the previous build's web search useless.
WEB_DOMAINS=

# The subject domain, used by the scope check and the answer prompt. Changing corpus means
# changing this line and re-running ingestion — nothing else. See AGENTS.md.
DOMAIN_DESCRIPTION=vehicle owner manuals

# Topics where a wrong answer can injure someone. Answered from the manual or escalated,
# never improvised. Corpus knowledge, so it lives here rather than in code (D13).
# For medical devices this might read: sterilisation, dosage, implantation, disposal.
SAFETY_TOPICS=braking,airbags,seat belts and restraints,towing,jacking and lifting,high-voltage battery
